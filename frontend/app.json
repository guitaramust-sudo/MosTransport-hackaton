{
  "expo": {
    "name": "Проводник ВСМ",
    "slug": "vsm-conductor-trainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.moscowtransport.vsmtrainer"
    },
    "android": {
      "package": "ru.moscowtransport.vsmtrainer",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#016EE4"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      "expo-audio"
    ],
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
