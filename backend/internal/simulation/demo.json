{
  "id": "demo_service_branch",
  "version": "1.0.0",
  "validation_status": "draft",
  "start_event": "service_request",
  "events": [
    {
      "id": "service_request",
      "text": "Пассажир просит услугу, наличие которой пока не проверено.",
      "choices": [
        {"id": "check_availability", "text": "Проверить наличие прежде чем обещать", "next_event": "confirmed_request", "effects": {"availability_checked": true}, "loyalty_delta": 3, "explanation": "Игрок проверил факт до обещания."},
        {"id": "promise_immediately", "text": "Пообещать услугу без проверки", "next_event": "unconfirmed_promise", "effects": {"promise_unverified": true}, "loyalty_delta": -4, "explanation": "Обещание дано без проверки доступности."}
      ]
    },
    {
      "id": "confirmed_request",
      "text": "Услуга доступна. Пассажир ждёт ответа.",
      "choices": [
        {"id": "explain_next_step", "text": "Сообщить пассажиру следующий шаг", "requires": ["availability_checked"], "effects": {"request_resolved": true}, "loyalty_delta": 4, "explanation": "Игрок дал подтверждённый ответ."}
      ]
    },
    {
      "id": "unconfirmed_promise",
      "text": "Услуга недоступна. Пассажир напоминает об обещании.",
      "choices": [
        {"id": "correct_promise", "text": "Признать ошибку и объяснить альтернативу", "requires": ["promise_unverified"], "effects": {"promise_corrected": true}, "loyalty_delta": 2, "explanation": "Игрок исправил обещание, но первоначальная ошибка сохранилась в пути."},
        {"id": "ignore_followup", "text": "Оставить обращение без ответа", "requires": ["promise_unverified"], "effects": {"request_abandoned": true}, "loyalty_delta": -8, "explanation": "Игрок не вернулся к пассажиру после обещания."}
      ]
    }
  ]
}
