# Use one Compose project from the repository root and backend directory.
COMPOSE_PROJECT_NAME=backend

# PostgreSQL
DATABASE_URL=postgres://vsm:vsm@localhost:5432/vsm?sslmode=disable

# Server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Auth
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
POINTS_NAMESPACE=demo

# Local admin for this machine (created by bootstrap-admin). Not for production.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=your-strong-password

# Local test conductor account (created via POST /admin/players for manual testing).
TEST_PLAYER_EMAIL=conductor.test@vsm.local
TEST_PLAYER_PASSWORD=cAWtkk09JIFCd8SO2HwzeDSj

# LLM: mock | gigachat
LLM_MODE=gigachat

GIGACHAT_CLIENT_ID=01a0de46-2c4a-7bb5-be9f-f153737ca4c6
GIGACHAT_CLIENT_SECRET=5de5f36c-782e-4dc3-8173-e0c0b4833f90
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_INSECURE=true

# Game tuning
SITUATIONS_PER_SESSION=4
SITUATION_TIMEOUT=120s
MAX_TURNS_PER_SITUATION=3
