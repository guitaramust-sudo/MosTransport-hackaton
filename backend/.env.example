# Copy to .env (used by docker compose) or export directly.

# PostgreSQL
DATABASE_URL=postgres://vsm:vsm@localhost:5432/vsm?sslmode=disable

# Server
SERVER_PORT=8080
APP_ENV=development

# Auth
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
POINTS_NAMESPACE=demo

# LLM: mock | gigachat
LLM_MODE=mock

# GigaChat (only needed when LLM_MODE=gigachat)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_INSECURE=false

# Game tuning
SITUATIONS_PER_SESSION=4
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Admin bootstrap: read by the server on every startup (and by the standalone
# `bootstrap-admin` command). Leave empty to skip bootstrapping entirely.
# Keep this file out of git (.env is already .gitignore'd).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
